{
  "name": "sacramento-buy-nothing",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "dev:full": "concurrently -k \"vite --port=3000 --host=0.0.0.0\" \"tsx server/index.ts\"",
    "build": "node scripts/build-push-bundle.mjs && vite build",
    "build:android": "node scripts/build-push-bundle.mjs && vite build",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:apk": "bash scripts/build-android-apk.sh",
    "android:apk:debug": "bash scripts/build-android-apk.sh debug",
    "android:aab": "bash scripts/build-android-aab.sh",
    "runit": "bash scripts/runit.sh",
    "runit:dry": "bash scripts/runit.sh --dry-run",
    "runit:check": "node scripts/runit-check.mjs",
    "runit:merge-prs": "bash scripts/runit-merge-open-prs.sh",
    "runit:play-console": "node scripts/runit-play-console-summary.mjs",
    "android:play-assets": "bash scripts/generate-play-store-assets.sh",
    "android:play-screenshots": "node scripts/capture-play-store-screenshots.mjs",
    "android:play-screenshots-zip": "node scripts/pack-play-store-screenshots.mjs",
    "facebook:posts": "python3 scripts/generate-facebook-post-pictures.py",
    "facebook:newspaper-ad": "python3 scripts/generate-newspaper-ad.py",
    "play:reviewer-account": "node scripts/create-play-reviewer-account.mjs",
    "field:test": "node scripts/field-test.mjs",
    "field:test:web": "node scripts/field-test.mjs --web",
    "field:test:apk": "node scripts/field-test.mjs --apk",
    "export:user-emails": "node scripts/export-user-emails.mjs",
    "export:play-testers": "node scripts/export-user-emails.mjs --play-testers",
    "export:play-testers:internal": "node scripts/export-user-emails.mjs --play-testers --limit=100",
    "broadcast:send": "node --import tsx scripts/send-broadcast-notification.mjs",
    "convert:play-testers": "node scripts/convert-to-play-testers-csv.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "prelint": "node scripts/build-push-bundle.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.106.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^4.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.9.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
