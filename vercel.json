{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15,
      "includeFiles": "node_modules/{web-push,ws,@supabase,agent-base,https-proxy-agent,jws,safe-buffer}/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
