# App URL (used for OAuth callbacks, push subject, and self-referential links)
APP_URL="https://your-app.vercel.app"

# --- Supabase (client — safe to expose in the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-url.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# Aliases also supported:
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_PUBLISHABLE_KEY=...
# SUPABASE_URL=...
# SUPABASE_KEY=...

# --- Supabase service role (server only — never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Aliases also accepted by some API helpers:
# SUPABASE_SERVICE_KEY=...
# SUPABASE_SERVICE_ROLE=...
# SUPABASE_ANON_KEY=... (same as publishable/anon key for server auth checks)

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
# VITE_* is baked into the frontend at build time (required on Vercel).
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@sacbuynothing.org"

# --- Server secrets ---
# Secures Vercel cron: /api/cron/notification-jobs
CRON_SECRET="your-random-cron-secret"

# Supabase database webhooks → /api/webhooks/supabase-push
# Generate with: openssl rand -hex 32
SUPABASE_PUSH_WEBHOOK_SECRET="your-webhook-secret"
# Alias also accepted:
# PUSH_WEBHOOK_SECRET=...

# Push API server port (local Express: npm run dev:server)
PORT=3001

# --- Vercel deployment checklist ---
# 1. Set all variables above in Vercel (Production + Preview)
# 2. Include VITE_VAPID_PUBLIC_KEY so subscribe works after build
# 3. Include SUPABASE_SERVICE_ROLE_KEY so /api/push/send can deliver alerts
# 4. Redeploy after changing env vars
# 5. Optional local-only: CURSOR_CLOUD_AGENT=1, DISABLE_HMR=1 (vite.config.ts)