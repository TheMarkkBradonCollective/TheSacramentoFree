# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT SETUP (any of these names work on Vercel)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-url.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# Aliases also supported:
# SUPABASE_URL=...
# SUPABASE_KEY=...            (anon / publishable key — NOT the service role key)

# Supabase service role key — required for the push API server (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# VITE_* is baked into the frontend at build time (required on Vercel).
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
# Server-side only (Vercel → Settings → Environment Variables)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@sacbuynothing.org"

# Supabase service role — server only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Push API server port (local Express: npm run dev:server)
PORT=3001

# --- Vercel deployment checklist ---
# 1. Set all variables above in Vercel (Production + Preview)
# 2. Include VITE_VAPID_PUBLIC_KEY so subscribe works after build
# 3. Include SUPABASE_SERVICE_ROLE_KEY so /api/push/send and /api/push/test work
# 4. Redeploy after changing env vars
